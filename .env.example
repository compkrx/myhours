# All VITE_ variables are public. Never place a model key or service-role key here.
VITE_BASE_PATH=/
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional deployed, authenticated Supabase Edge Function (not a provider URL)
VITE_AI_FUNCTION_URL=
# Optional Google OAuth web client ID. No client secret belongs in this app.
VITE_GOOGLE_CLIENT_ID=
