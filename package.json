{
  "name": "myhours",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.md",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.89",
    "@supabase/supabase-js": "2.119.2",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "ical.js": "2.2.1",
    "jsep": "1.6.0",
    "lucide-react": "1.77.0",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.17",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
